         output of `generate_keys` from the Sparkle SPM checkout — see CONTRIBUTING. -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/pernielsentikaer/swiitch/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>7TU3J5/wl3/7E1hA2ANB0OzdLkLti0U/KGkqXhu2cIE=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUEnableInstallerLauncherService</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
</dict>
</plist>
