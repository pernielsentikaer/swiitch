      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vinduer"
          }
        }
      }
    },
    "Already used by the other shortcut or its Shift-reverse. Choose another combination.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges allerede af den anden genvej eller dens omvendte retning med Skift. Vælg en anden kombination."
          }
        }
      }
    },
    "App icon overlay": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placering af appikon"
          }
        }
      }
    },
    "App layout preview": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisning af apps"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udseende"
          }
        }
