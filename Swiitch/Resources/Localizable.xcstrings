      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle apps vises"
          }
        }
      }
    },
    "All visible": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle er synlige"
          }
        }
