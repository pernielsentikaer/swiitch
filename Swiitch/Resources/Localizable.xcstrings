      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1 vindue"
          }
        }
      }
    },
    "A native ⌘+Tab replacement that lets you switch between every window — not just apps.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En ⌘+Tab-erstatning til Mac, der lader dig skifte mellem alle vinduer — ikke kun apps."
          }
        }
      }
    },
    "A preview could not be captured. Swiitch retries automatically; you can still switch to this window.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisningen kunne ikke hentes. Swiitch prøver automatisk igen. Du kan stadig skifte til vinduet."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om"
          }
        }
      }
    },
    "Accent color": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Accentfarve"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgængelighed"
          }
        }
      }
    },
    "Accessibility access": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til tilgængelighed"
          }
        }
      }
    },
    "Accessibility access is needed. Open Swiitch’s General settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til tilgængelighed er nødvendig. Åbn Generelt i Swiitchs indstillinger."
          }
        }
      }
    },
    "Activate to restore and switch to this window. Window actions are available in the Actions menu.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér for at gendanne og skifte til dette vindue. Vindueshandlinger findes i menuen Handlinger."
          }
        }
      }
    },
    "Activate to switch to this window. Window actions are available in the Actions menu.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér for at skifte til dette vindue. Vindueshandlinger findes i menuen Handlinger."
          }
        }
      }
    },
    "Active screen (frontmost window)": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen med det aktive vindue"
          }
        }
      }
    },
    "Add App…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj app…"
          }
        }
      }
    },
    "Add an app to hide all of its windows from Swiitch.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en app for at skjule alle dens vinduer i Swiitch."
