        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassisk"
          }
        }
      }
    },
    "Click a recorder, press your shortcut. Esc cancels. The second hotkey jumps straight to the frontmost app's windows.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på et genvejsfelt, og tryk på din genvej. Esc annullerer. Den anden genvej går direkte til den aktive apps vinduer."
          }
        }
      }
    },
