            "state": "translated",
            "value": "Vis ikke"
          }
        }
      }
    },
    "Enable Screen Recording in Swiitch Preferences → General to show previews. Window switching still works without it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad skærmoptagelse under Generelt i Swiitchs indstillinger for at vise forhåndsvisninger. Du kan stadig skifte vinduer uden."
          }
        }
      }
    },
    "Example items only. Does not change your open windows.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun eksempler. Dine åbne vinduer ændres ikke."
          }
