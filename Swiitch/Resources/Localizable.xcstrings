            "value": "Tilladt"
          }
        }
      }
    },
    "Heavily blurred — barely shows what's behind.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraftig udviskning — baggrunden er næsten ikke synlig."
          }
        }
      }
    },
    "Hidden": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult"
          }
        }
      }
    },
    "Hotkeys": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturgenveje"
          }
        }
      }
    },
    "Hotkeys, appearance, menu bar and Dock icons, pinned apps, and excluded apps will all be reset. Launch at Login and onboarding are left as they are.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturgenveje, udseende, menulinje- og Dock-ikoner, fastgjorte apps og udeladte apps nulstilles. Åbn ved login og introduktionen ændres ikke."
          }
        }
      }
    },
    "Hovering — or navigating with the keyboard — to a cell will bring that window forward without dismissing the picker. Release ⌘ commits.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold markøren over et vindue, eller vælg det med tastaturet, for at vise det forrest uden at lukke vinduesvælgeren. Slip ⌘ for at bekræfte."
          }
        }
      }
    },
    "Include %@ again": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis %@ igen"
          }
        }
      }
    },
