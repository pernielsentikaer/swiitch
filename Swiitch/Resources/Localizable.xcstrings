    "Couldn’t change Launch at Login. Try again or check Login Items in System Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke ændre Åbn ved login. Prøv igen, eller kontrollér Loginemner i Systemindstillinger."
